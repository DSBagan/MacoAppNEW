<Window x:Class="TBMFurn.ExcelReplacer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение артикулов с каталогом" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовки -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Пользовательский список" FontWeight="Bold" FontSize="14" Margin="5"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Финальный список (после замен и суммирования)" FontWeight="Bold" FontSize="14" Margin="5"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="10,5,10,5">
            <Button x:Name="BtnPasteFromClipboard" Content="📋 Вставить из буфера" Click="BtnPasteFromClipboard_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnSaveExcel" Content="💾 Сохранить в Excel для КП в КИС 2.0" Click="BtnSaveExcel_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnSaveExcelForKIS" Content="💾 Сохранить в Excel для КП в КИС" Click="BtnSaveExcelForKIS_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnEditCatalog" Content="⚙ Редактировать каталог" Click="BtnEditCatalog_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnProcess" Content="🔄 Обработать" Click="BtnProcess_Click" Height="35" Margin="5" Background="LightGreen"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
        </StackPanel>

        <!-- Таблица пользователя -->
        <Border Grid.Row="1" Grid.Column="0" Margin="5" CornerRadius="8" Background="White" Padding="2">
            <DataGrid x:Name="UserDataGrid" AutoGenerateColumns="False" 
                      CanUserAddRows="True" IsReadOnly="False"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="Gray"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat=N0}" Width="1*"/>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Финальная таблица -->
        <Border Grid.Row="1" Grid.Column="2" Margin="5" CornerRadius="8" Background="White" Padding="2">
            <DataGrid x:Name="FinalDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="Gray"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat=N0}" Width="1*"/>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="2.2*"/>
                    <DataGridTemplateColumn Header="Заменен?" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="4" Margin="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReplaced}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#4CAF50" Offset="0"/>
                                                                <GradientStop Color="#66BB6A" Offset="0.5"/>
                                                                <GradientStop Color="#81C784" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Padding="2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Нет"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReplaced}" Value="True">
                                                        <Setter Property="Text" Value="{Binding ReplacementInfo}"/>
                                                        <Setter Property="FontSize" Value="9"/>
                                                        <Setter Property="LineHeight" Value="12"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="5" Padding="5" CornerRadius="3" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Text="✅ Готов" FontSize="12" Foreground="Green"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>