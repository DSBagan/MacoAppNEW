<Window x:Class="TBMFurn.ExcelReplacer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение артикулов с каталогом" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовки -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Пользовательский список" FontWeight="Bold" FontSize="14" Margin="5"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Финальный список (после замен и суммирования)" FontWeight="Bold" FontSize="14" Margin="5"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="10">
            <Button x:Name="BtnPasteFromClipboard" Content="📋 Вставить из буфера" Click="BtnPasteFromClipboard_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnSaveExcel" Content="💾 Сохранить в Excel" Click="BtnSaveExcel_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnEditCatalog" Content="⚙ Редактировать каталог" Click="BtnEditCatalog_Click" Height="35" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnProcess" Content="🔄 Обработать" Click="BtnProcess_Click" Height="35" Margin="5" Background="LightGreen"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
        </StackPanel>

        <!-- Таблица пользователя -->
        <DataGrid x:Name="UserDataGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" 
                  CanUserAddRows="True" Margin="5" IsReadOnly="False">
            <DataGrid.Columns>
                <!-- Колонка с номером строки -->
                <DataGridTextColumn Header="№" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat=N0}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Финальная таблица -->
        <DataGrid x:Name="FinalDataGrid" Grid.Row="1" Grid.Column="2" AutoGenerateColumns="False" Margin="5" IsReadOnly="True">
            <DataGrid.Columns>
                <!-- Колонка с номером строки -->
                <DataGridTextColumn Header="№" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat=N0}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="*"/>
                <DataGridTemplateColumn Header="Заменен?" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Нет"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReplaced}" Value="True">
                                                <Setter Property="Text" Value="Да"/>
                                                <Setter Property="Background" Value="LightGreen"/>
                                                <Setter Property="Padding" Value="5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="5" Padding="5" CornerRadius="3" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Text="✅ Готов" FontSize="12" Foreground="Green"/>
            </StackPanel>
        </Border>
    </Grid>
    
</Window>