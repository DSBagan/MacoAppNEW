<Window x:Class="TBMFurn.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введите пароль" Height="200" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Cursor="">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Для редактирования каталога введите пароль:" Margin="5"/>

        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Margin="5" Height="30"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button x:Name="BtnOk" Content="OK" Click="BtnOk_Click" Width="80" Height="30" Margin="5" IsDefault="True"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click" Width="80" Height="30" Margin="5" IsCancel="True"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
        </StackPanel>
    </Grid>
</Window>