<Window x:Class="TBMFurn.CatalogEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор каталога замен" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="BtnPasteFromClipboard" Content="📋 Вставить из буфера" 
            Click="BtnPasteFromClipboard_Click" Height="30" Margin="5" Width="180"
            Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnDeleteSelected" Content="🗑 Удалить выбранные" 
            Click="BtnDeleteSelected_Click" Height="30" Margin="5" Width="180" Background="LightCoral"
            Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnRefreshFromDB" Content="🔄 Обновить из БД" 
            Click="BtnRefreshFromDB_Click" Height="30" Margin="5" Width="180"
            Style="{StaticResource MaterialDesignPaperLightButton}"/>
            
        </StackPanel>

        <!-- Панель поиска -->
        <Border Grid.Row="1" Margin="5" Padding="5" Background="#F0F0F0" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="Bold"/>
                <TextBox x:Name="TxtSearch" Width="250" Height="30" TextChanged="TxtSearch_TextChanged" 
                         ToolTip="Введите артикул для поиска"/>
                <Button x:Name="BtnClearSearch" Content="✖ Очистить" Click="BtnClearSearch_Click" 
                        Width="120" Height="30" Margin="10,0,0,0"
                        Style="{StaticResource MaterialDesignPaperLightButton}"/>
                <TextBlock x:Name="TxtSearchResult" Text="Найдено: 0" VerticalAlignment="Center" 
                           Margin="15,0,0,0" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- Индикатор статуса -->
        <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="Статус: Готов" 
                   Margin="5" FontSize="11" Foreground="Blue"/>

        <!-- Таблица каталога -->
        <DataGrid x:Name="CatalogGrid" Grid.Row="3" AutoGenerateColumns="False" 
                  CanUserAddRows="True" Margin="5" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Старый артикул" Binding="{Binding OldArticle}" Width="2*"/>
                <DataGridTextColumn Header="Артикул замена" Binding="{Binding NewArticle}" Width="2*"/>
                <DataGridTextColumn Header="Коэффициент количества" Binding="{Binding Factor}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки сохранения/отмены -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button x:Name="BtnBackup" Content="💾 Создать бэкап"
                    Click="BtnBackup_Click" Height="30" Margin="5" Width="222" Background="LightBlue"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnRestoreFromBackup" Content="🔄 Восстановить из бэкапа"
                    Click="BtnRestoreFromBackup_Click" Height="30" Margin="5" Width="227" Background="LightYellow"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnSave" Content="Сохранить в БД" Click="BtnSave_Click" Width="150" Height="30" Margin="5" Background="LightGreen"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
            <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click" Width="100" Height="30" Margin="5"
                    Style="{StaticResource MaterialDesignPaperLightButton}"/>
        </StackPanel>
    </Grid>
</Window>