<Window x:Class="MacoApp.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Последние изменения" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="History" Width="28" Height="28" Foreground="White" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="📋 История изменений" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="Black">
                        <!-- Тень с минимальным размытием -->
                        <TextBlock.Effect>
                            <DropShadowEffect 
                                BlurRadius="2" 
                                ShadowDepth="1" 
                                Direction="270" 
                                Opacity="0.12" 
                                Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Список изменений -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl x:Name="ChangelogItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6" Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <!-- Заголовок версии -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" 
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Version}" 
                                               FontWeight="Bold" FontSize="14" 
                                               Foreground="{DynamicResource MaterialDesignBody}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect 
                                                BlurRadius="1" 
                                                ShadowDepth="1" 
                                                Direction="270" 
                                                Opacity="0.1" 
                                                Color="#000000"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="12" 
                                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect 
                                                BlurRadius="1" 
                                                ShadowDepth="1" 
                                                Direction="270" 
                                                Opacity="0.08" 
                                                Color="#000000"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <!-- Список изменений -->
                                <ItemsControl ItemsSource="{Binding Changes}" Margin="20,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="• " Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                           FontWeight="Bold" 
                                                           FontSize="13"/>
                                                <TextBlock Text="{Binding}" 
                                                           Foreground="{DynamicResource MaterialDesignBody}" 
                                                           TextWrapping="Wrap" 
                                                           FontSize="13">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect 
                                                            BlurRadius="1" 
                                                            ShadowDepth="0.5" 
                                                            Direction="270" 
                                                            Opacity="0.08" 
                                                            Color="#000000"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть" Click="CloseButton_Click" Width="100" Height="35"
                    Style="{StaticResource MaterialDesignPaperLightButton}"
                    Foreground="Black"
                    materialDesign:ButtonAssist.CornerRadius="8"/>
        </StackPanel>
    </Grid>
</Window>