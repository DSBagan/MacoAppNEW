<Window x:Class="TBMFurn.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Обратная связь" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель пользователя -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtUserName" Width="150" Margin="5" ToolTip="Ваше имя"/>
                <TextBox x:Name="txtUserContact" Width="200" Margin="5" ToolTip="Email или телефон для связи"/>
                <CheckBox x:Name="chkAdminMode" Content="Режим админа" Margin="10,5" 
                          Checked="ChkAdminMode_Checked" Unchecked="ChkAdminMode_Unchecked"/>
                <PasswordBox x:Name="txtAdminPassword" Width="120" Margin="5" 
                             Visibility="Collapsed" ToolTip="Пароль админа"/>
                <Button x:Name="btnLogin" Content="Войти" Click="BtnLogin_Click" Margin="5"
                        Style="{StaticResource MaterialDesignPaperLightButton}"/>
                <TextBlock x:Name="lblUserStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Green"/>
            </StackPanel>
        </Border>

        <!-- Список сообщений -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="spMessages"/>
        </ScrollViewer>

        <!-- Форма отправки -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtNewMessage" MinHeight="60" TextWrapping="Wrap" 
                         AcceptsReturn="True" Margin="0,0,0,5"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="📎 Прикрепить файл" Click="BtnAttach_Click" Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignPaperLightButton}"/>
                    <TextBlock x:Name="lblAttachedFile" VerticalAlignment="Center" Foreground="Gray"/>
                    <Button x:Name="btnSend" Content="Отправить" Click="BtnSend_Click" 
                            Style="{StaticResource MaterialDesignPaperLightButton}"
                            HorizontalAlignment="Right" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
