<Window x:Class="TBMFurn.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="💬 Обратная связь" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,-5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель пользователя -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="8" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtUserName" Width="150" Margin="5" 
                             ToolTip="👤 Введите ваше имя или никнейм (обязательно)"
                             materialDesign:HintAssist.Hint="Ваше имя" FontSize="14"/>

                    <TextBox x:Name="txtUserContact" Width="200" Margin="5" 
                             ToolTip="📧 Укажите email или телефон для обратной связи"
                             materialDesign:HintAssist.Hint="Email или телефон" FontSize="14"/>

                    <CheckBox x:Name="chkAdminMode" Content="🔐 Режим админа" Margin="10,5" 
                              Checked="ChkAdminMode_Checked" Unchecked="ChkAdminMode_Unchecked"
                              ToolTip="Вход в режим администратора для просмотра всех сообщений"/>

                    <PasswordBox x:Name="txtAdminPassword" Width="120" Margin="5" 
                                 Visibility="Collapsed" 
                                 ToolTip="🔑 Введите пароль администратора"
                                 materialDesign:HintAssist.Hint="Пароль"/>

                    <Button x:Name="btnLogin" Content="Войти" Click="BtnLogin_Click" Margin="5"
                            Style="{StaticResource MaterialDesignPaperLightButton}"
                            ToolTip="Войти в систему"/>

                    <TextBlock x:Name="lblUserStatus" Margin="10,0,0,0" VerticalAlignment="Center" 
                               Foreground="Green" FontSize="11"/>
                </StackPanel>

                <TextBlock Text="💡 Подсказка: Нужны для обратной связи" 
                           Style="{StaticResource HelpTextStyle}" Margin="5,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список сообщений (только для админа) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок списка сообщений (только для админа) -->
            <Border x:Name="panelMessagesHeader" Grid.Row="0" Background="#E3F2FD" Padding="10" 
                    CornerRadius="8" Margin="0,0,0,5" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋 Список сообщений пользователей" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="lblMessageCount" Text="(0)" Margin="10,0,0,0" Foreground="Gray"/>
                    <Button x:Name="btnExportMessages" Content="📎 Экспорт в Excel" Click="BtnExportMessages_Click" 
                            Margin="20,0,0,0" Padding="8,3" FontSize="11"
                            Style="{StaticResource MaterialDesignPaperLightButton}"
                            ToolTip="Экспортировать все сообщения в Excel файл"/>
                </StackPanel>
            </Border>

            <!-- Область сообщений (только для админа) -->
            <ScrollViewer x:Name="scrollMessages" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel x:Name="spMessages"/>
            </ScrollViewer>

            <!-- Сообщение для обычных пользователей -->
            <Border x:Name="panelUserInfo" Grid.Row="1" Background="#FFF3E0" Padding="20" 
                    CornerRadius="8" Margin="0,0,0,5" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💬" FontSize="30" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Форма отправки -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" CornerRadius="8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtNewMessage" MinHeight="240" TextWrapping="Wrap" FontSize="16"
                         AcceptsReturn="True" Margin="0,0,0,8"
                         materialDesign:HintAssist.Hint="💬 Введите ваше сообщение..."
                         ToolTip="Напишите ваш вопрос, предложение или отзыв"/>

                <TextBlock Grid.Row="1" Text="💡 Подсказка: Опишите подробно ваш вопрос, прикрепите скрин"
                           Style="{StaticResource HelpTextStyle}" Margin="5,0,0,5"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="btnAttach" Content="📎 Прикрепить файл" Click="BtnAttach_Click" Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignPaperLightButton}"
                            ToolTip="Прикрепите скриншот или документ (изображения, PDF)"/>

                    <TextBlock x:Name="lblAttachedFile" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>

                    <Button x:Name="btnSend" Content="📤 Отправить" Click="BtnSend_Click" 
                            Style="{StaticResource MaterialDesignPaperLightButton}"
                            HorizontalAlignment="Right" Width="130" Margin="10,0,0,0"
                            ToolTip="Отправить сообщение" Background="LightGreen"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>